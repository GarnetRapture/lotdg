{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,

    /* 경로 별칭 — vite.config.ts 의 resolve.alias 와 동일하게 유지한다.
       TypeScript 7 은 baseUrl 을 제거했으므로 paths 는 상대 경로로 적는다. */
    "paths": {
      "@app/*": ["./src/app/*"],
      "@feature/*": ["./src/feature/*"],
      "@shared/*": ["./src/shared/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@style/*": ["./src/style/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
